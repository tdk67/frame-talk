{
  "app_name": "Frame Talk",
  "domain": "taskmind-ai.com",
  "app_subdomain": "frame-talk",
  "grafana_subdomain": "grafana",
  "version": "1.0.0",
  "models": {
    "vision_model": "gemini-3.7-flash",
    "script_model": "gemini-3.7-flash",
    "qa_model": "gemini-3.7-flash",
    "eval_model": "gemini-3.7-flash",
    "tts_model": "gemini-3.1-flash-tts-preview"
  },
  "voices": {
    "default_male": "Puck",
    "default_female": "Kore",
    "male_host_name": "Alex",
    "female_host_name": "Sarah"
  },
  "retries": {
    "max_attempts": 4,
    "initial_delay_sec": 2.0,
    "backoff_multiplier": 2.0,
    "retriable_status_codes": [429, 500, 502, 503, 504],
    "non_retriable_status_codes": [400, 401, 403, 404]
  },
  "timeouts": {
    "gemini_api_sec": 120,
    "file_processing_wait_max_sec": 180
  },
  "quota": {
    "max_hosted_videos_per_user": 3,
    "max_hosted_cost_per_user_usd": 1.00,
    "global_daily_max_hosted_videos": 50,
    "global_daily_max_hosted_cost_usd": 5.00
  },
  "storage": {
    "uploads_dir": "uploads",
    "output_dir": "output",
    "public_dir": "public"
  },
  "clickhouse": {
    "host": "localhost",
    "port": 8123,
    "database": "castops",
    "table": "sync_events"
  },
  "video_limits": {
    "min_duration_seconds": 30.0,
    "max_duration_seconds": 300.0,
    "max_file_size_mb": 500.0,
    "supported_extensions": [".mp4", ".webm", ".mov", ".mkv"]
  }
}
