# ==============================================================================
# Frame Talk: Environment Configuration & Domain Settings
# ==============================================================================

# 1. Google Gemini Multimodal & TTS API Key
# Used for server-side processing, benchmark evaluations, and Hosted Demo Mode.
# (Client web UI also supports BYOK where users provide their own key for unlimited runs).
GOOGLE_API_KEY=AIzaSy...

# 2. Google Cloud Vertex AI / Agent Builder Enterprise Platform Mode (Optional)
# Set to 'true' to execute models directly on Google Cloud Vertex AI Enterprise
# using Application Default Credentials (ADC) or service account credentials.
# GOOGLE_GENAI_USE_VERTEXAI=false
# GOOGLE_CLOUD_PROJECT=agentic-cinema-frametalk
# GOOGLE_CLOUD_LOCATION=us-central1

# 3. Hosted Demo Quota & Rate Limiting (Protects server key against cost overruns)
# MAX_HOSTED_VIDEOS_PER_USER=3
# MAX_HOSTED_COST_PER_USER_USD=1.00

# 4. Domain & Hosting Configuration (Easy to move to any new domain!)
# Set your root domain here. All endpoints, sitemaps, robots.txt, and CORS rules
# will automatically reconfigure to this domain without editing source code.
APP_DOMAIN=taskmind-ai.com
APP_SUBDOMAIN=frame-talk
GRAFANA_SUBDOMAIN=grafana

# Optional explicit full URLs (overrides auto-constructed URLs above if set):
# APP_URL=https://frame-talk.taskmind-ai.com
# GRAFANA_URL=https://grafana.taskmind-ai.com

# Optional custom CORS origins (comma-separated list):
# CORS_ORIGINS=https://frame-talk.taskmind-ai.com,https://grafana.taskmind-ai.com,http://localhost:8000

# 5. Model Overrides (Optional)
# VISION_MODEL=gemini-3.7-flash
# SCRIPT_MODEL=gemini-3.7-flash
# QA_MODEL=gemini-3.7-flash
# TTS_MODEL=gemini-3.1-flash-tts-preview

# 6. ClickHouse Telemetry Store (Optional)
# CLICKHOUSE_HOST=localhost
# CLICKHOUSE_PORT=8123
